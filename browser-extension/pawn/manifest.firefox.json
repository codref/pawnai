{
  "manifest_version": 3,
  "name": "Pawn Capture",
  "version": "0.3.1",
  "description": "Capture snippets into the Pawn vault and chat with Pawn about the page.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://teams.microsoft.com/*",
        "*://*.teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://teams.cloud.microsoft/*"
      ],
      "js": [
        "content/adapters/teams.js",
        "content/overlays.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Pawn Capture",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "action": {
    "default_title": "Pawn Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pawn-capture@pawnai.local",
      "strict_min_version": "121.0"
    }
  }
}
