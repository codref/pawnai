{
  "name": "pawn-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Pawn Portal: chat-first web workspace served by pawn-server at /portal.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_PAWN_MOCK=1 vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@quasar/extras": "2.1.0",
    "dompurify": "3.4.17",
    "markdown-it": "14.3.3",
    "pinia": "3.0.4",
    "quasar": "2.35.4",
    "vue": "3.5.45",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "2.0.2",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "jsdom": "31.0.0",
    "sass-embedded": "1.108.2",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
